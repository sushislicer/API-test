# Source this from the API checkout root, or set API_ROOT before sourcing.
#
#   cd /path/to/API
#   source eval_system/configs/paths.example.env

export API_ROOT="${API_ROOT:-$(pwd)}"
export DOWNLOAD_ROOT="${DOWNLOAD_ROOT:-${API_ROOT}/downloads}"

export LDA_1B_ROOT="${LDA_1B_ROOT:-${API_ROOT}/models/LDA-1B}"
export LDA_1B_CHECKPOINT_ROOT="${LDA_1B_CHECKPOINT_ROOT:-${DOWNLOAD_ROOT}/checkpoints/lda-1b}"

export LINGBOT_VA_ROOT="${LINGBOT_VA_ROOT:-${API_ROOT}/models/lingbot-va}"
export LINGBOT_VA_CHECKPOINT_ROOT="${LINGBOT_VA_CHECKPOINT_ROOT:-${DOWNLOAD_ROOT}/checkpoints/lingbot-va}"

export MOTUS_ROOT="${MOTUS_ROOT:-${API_ROOT}/models/motus}"
export MOTUS_CHECKPOINT_ROOT="${MOTUS_CHECKPOINT_ROOT:-${DOWNLOAD_ROOT}/checkpoints/motus}"

export FASTWAM_ROOT="${FASTWAM_ROOT:-${API_ROOT}/models/fastwam}"
export FASTWAM_CHECKPOINT_ROOT="${FASTWAM_CHECKPOINT_ROOT:-${DOWNLOAD_ROOT}/checkpoints/fastwam}"

export ROBOTWIN_ROOT="${ROBOTWIN_ROOT:-${API_ROOT}/simulators/RoboTwin}"
export ROBOTWIN_ASSET_ROOT="${ROBOTWIN_ASSET_ROOT:-${DOWNLOAD_ROOT}/assets/robotwin}"

export LIBERO_ROOT="${LIBERO_ROOT:-${API_ROOT}/simulators/LIBERO}"
export LIBERO_DATA_ROOT="${LIBERO_DATA_ROOT:-${DOWNLOAD_ROOT}/datasets/libero}"

